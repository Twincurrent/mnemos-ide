#!/usr/bin/env bash
#
# Prepares bundled resources for distribution.
#
# This script copies resources that should be bundled with Mnemos into a
# destination directory. It is used by macOS and Linux build scripts.
#
# Usage:
#   prepare_bundled_resources <destination_directory> [channel] [cargo_profile]
#
# Arguments:
#   destination_directory:  The directory where resources should be installed.
#                           Resources will be copied to subdirectories within
#                           this path.
#   channel:                (Optional) Release channel (stable). Passed to the
#                           settings schema generator.
#   cargo_profile:          (Optional) Cargo build profile to use when
#                           generating the settings schema. Reusing the same
#                           profile as the main build avoids recompiling deps.
#
# Environment variables:
#   SKIP_SETTINGS_SCHEMA: Set to "1" to skip generating the JSON settings
#                         schema. By default the schema is always generated
#                         so that production bundles never accidentally omit it.

set -e

if [ $# -lt 1 ] || [ $# -gt 3 ]; then
  echo "Error: Expected 1-3 arguments but received $#" >&2
  echo "Usage: $0 <destination_directory> [channel] [cargo_profile]" >&2
  exit 1
fi

DEST_DIR="$1"
CHANNEL="${2:-}"
CARGO_PROFILE="${3:-}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
RESOURCES_SRC="$REPO_ROOT/resources"

# Validate that the source resources directory exists
if [ ! -d "$RESOURCES_SRC" ]; then
  echo "Error: Resources directory not found at $RESOURCES_SRC" >&2
  exit 1
fi

# Create the destination directory if it doesn't exist
mkdir -p "$DEST_DIR"

# Mnemos IDE: resources/bundled (Warp's bundled agent skills) is gone. Remove the skills an older
# build of this script copied into the destination, so they cannot ride along into a new bundle.
rm -rf "$DEST_DIR/bundled/skills" "$DEST_DIR/bundled/mcp_skills" "$DEST_DIR/bundled/.DS_Store"

if [ -n "$GIT_RELEASE_TAG" ]; then
  VERSION_METADATA_DIR="$DEST_DIR/bundled/metadata"
  VERSION_METADATA_PATH="$VERSION_METADATA_DIR/version.json"

  echo "Writing bundled Mnemos version metadata to $VERSION_METADATA_PATH"
  mkdir -p "$VERSION_METADATA_DIR"
  printf '{\n  "mnemos_version": "%s"\n}\n' "$GIT_RELEASE_TAG" > "$VERSION_METADATA_PATH"
fi

# Generate third-party license attribution.
#
# Additional (non-Cargo) third-party license files to include in the output.
# Each entry is: "Component Name|License Identifier|path/to/LICENSE/relative/to/repo/root"
# When adding a new third-party component to the bundle, add its license file
# to the repo alongside the component and add an entry here.
# Keep this list in step with $AdditionalLicenses in script/windows/prepare_bundled_resources.ps1.
ADDITIONAL_LICENSES=(
    "Hack Font|MIT|app/assets/bundled/fonts/hack/LICENSE.md"
    "Roboto Font|SIL Open Font License|app/assets/bundled/fonts/roboto/LICENSE.txt"
    "Roboto font files (their name table declares Apache-2.0, Copyright 2011 Google Inc.)|Apache-2.0|licenses/Apache-2.0.txt"
    "Roboto Flex Font|SIL Open Font License|licenses/roboto-flex-OFL-1.1.txt"
    "bash-preexec|MIT|app/assets/bundled/bootstrap/bash-preexec-LICENSE.md"
    "rudder-sdk-rust|MIT|app/src/server/telemetry/LICENSE-RUDDER-SDK-RUST.txt"
    "Windows Terminal|MIT|app/assets/windows/LICENSE-WINDOWS-TERMINAL"
    "GitHub Desktop|MIT|app/src/code_review/GITHUB-DESKTOP-LICENSE"
    "Command signatures and completion metadata (warp-command-signatures, warp-completion-metadata; Warp, derived from Fig)|MIT|licenses/command-signatures-MIT.txt"
    "Warp workflows (warp-workflows, warp-workflows-types)|Apache-2.0|licenses/warp-workflows-Apache-2.0.txt"
    "Command corrections (Warp, derived from thefuck)|MIT|licenses/command-corrections-MIT.txt"
    "tree-sitter Ruby queries (Rob Rix)|MIT|licenses/tree-sitter-ruby-queries-MIT.txt"
    "nvim-treesitter queries|Apache-2.0|licenses/nvim-treesitter-queries-Apache-2.0.txt"
    "tree-sitter Scala queries (Max Brunsfeld and GitHub)|MIT|licenses/tree-sitter-scala-queries-MIT.txt"
    "Reachability (Tony Million)|BSD-2-Clause|licenses/reachability-BSD-2-Clause.txt"
)

# AGPL-3.0 sections 5(d) and 6: every bundle carries the license texts and a NOTICE that names
# the commit it was built from and where that commit's source is published.
cp "$REPO_ROOT/LICENSE-AGPL" "$REPO_ROOT/LICENSE-MIT" "$DEST_DIR/"
SOURCE_URL="${MNEMOS_SOURCE_URL:-$(grep -v '^[[:space:]]*#' "$REPO_ROOT/script/source-url" | grep -m1 -v '^[[:space:]]*$' || true)}"
SOURCE_URL="${SOURCE_URL%/}"
SOURCE_COMMIT="${MNEMOS_GIT_COMMIT:-$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || true)}"
{
  cat "$REPO_ROOT/NOTICE"
  printf '\nSource code of this build\n-------------------------\n\n'
  if [ -n "$SOURCE_COMMIT" ]; then
    printf 'This copy of Mnemos IDE was built from commit %s.\n' "$SOURCE_COMMIT"
    printf 'Its complete Corresponding Source is at:\n\n  %s/tree/%s\n' "$SOURCE_URL" "$SOURCE_COMMIT"
    if [ -n "${GIT_RELEASE_TAG:-}" ]; then
      printf '\nThe source archive of this release, with the vendored source of every Rust\n'
      printf 'dependency, is Mnemos-source-%s.tar.gz,\npublished next to its installers.\n' "$SOURCE_COMMIT"
    fi
    # Untracked files count: they are not in the published source of that commit.
    # script/macos/release reads this line back and refuses to publish such a build.
    if [ -n "$(git -C "$REPO_ROOT" status --porcelain 2>/dev/null)" ]; then
      printf '\nThis is NOT a release build: the tree had uncommitted or untracked changes when it was built.\n'
    fi
    if [ "${MNEMOS_SOURCE_UNPUBLISHED:-}" = "1" ]; then
      printf '\nThis is an internal TwinCurrent build: its commit was not on the public\nrepository when it was built.\n'
    fi
  else
    printf 'Source repository: %s\n' "$SOURCE_URL"
  fi
} > "$DEST_DIR/NOTICE"

# Build the third-party licenses file unless the NO_LICENSES envvar is set.
if [ -z "$NO_LICENSES" ]; then
  LICENSES_OUTPUT="$DEST_DIR/THIRD_PARTY_LICENSES.txt"
  echo "Generating third-party licenses at $LICENSES_OUTPUT"
  cargo about generate \
      --workspace \
      --manifest-path "$REPO_ROOT/Cargo.toml" \
      -c "$REPO_ROOT/about.toml" \
      -o "$LICENSES_OUTPUT" \
      --fail \
      "$REPO_ROOT/about.hbs"

  # Append additional (non-Cargo) third-party licenses.
  for entry in "${ADDITIONAL_LICENSES[@]}"; do
      IFS='|' read -r name license_id license_path <<< "$entry"
      license_file="$REPO_ROOT/$license_path"
      if [ ! -f "$license_file" ]; then
          echo "Error: License file not found: $license_file" >&2
          exit 1
      fi
      printf '\n%s (%s)\n' "$name" "$license_id" >> "$LICENSES_OUTPUT"
      printf '%0.s-' {1..80} >> "$LICENSES_OUTPUT"
      printf '\n' >> "$LICENSES_OUTPUT"
      cat "$license_file" >> "$LICENSES_OUTPUT"
      printf '\n' >> "$LICENSES_OUTPUT"
  done
fi

# Generate settings JSON schema unless explicitly skipped.
if [ "${SKIP_SETTINGS_SCHEMA:-}" != "1" ]; then
  SCHEMA_OUTPUT="$DEST_DIR/settings_schema.json"
  echo "Generating settings schema at $SCHEMA_OUTPUT"

  SCHEMA_CMD=(cargo run)
  if [ -n "$CARGO_PROFILE" ]; then
    SCHEMA_CMD+=(--profile "$CARGO_PROFILE")
  fi
  SCHEMA_CMD+=(--manifest-path "$REPO_ROOT/Cargo.toml" --bin generate_settings_schema --)
  if [ -n "$CHANNEL" ]; then
    SCHEMA_CMD+=(--channel "$CHANNEL")
  fi
  SCHEMA_CMD+=("$SCHEMA_OUTPUT")

  "${SCHEMA_CMD[@]}"
fi

# No agent runtime is bundled, so nothing from Anthropic ships in a Mnemos
# bundle. Remove an agent/ dir an older build of this script left in the
# destination, so it cannot ride along into a new bundle.
rm -rf "$DEST_DIR/agent"

echo "Successfully prepared bundled resources in $DEST_DIR"
