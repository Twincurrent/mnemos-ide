[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Mnemos
GenericName=TerminalEmulator

Exec=mnemos-terminal %U
StartupWMClass=dev.mnemos.Mnemos

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.mnemos.Mnemos

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for mnemos:// URLs.
MimeType=x-scheme-handler/mnemos;
