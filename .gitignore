app/Carthage
app/frameworks/default/Carthage
app/frameworks/dev/Carthage
app/frameworks/**/*.xcframework
/target
/app/target
/mnemos.xcworkspace
*.dmg
.idea/
.DS_Store
*.icloud
app/src/server/graphql/schema/generated

# For testing changes to the channel versions file
channel_versions_test.json

# Don't include any CPU profiling output by accident.
profile.pb

# Don't include any files that we write for testing purposes.
crates/mnemos_files/test_data/test_write

# Don't include fonts downloaded by the script used to generate font fallback code.
script/font_fallback/downloaded_fonts

# Don't include the generated Windows installer
script/windows/Output
.aider*

# temporary vim files. Source: https://github.com/github/gitignore/blob/main/Global/Vim.gitignore
*~
[._]*.s[a-v][a-z]
!*.svg # keep svg files
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Don't include the PTY recording.
mnemos.pty.recording

# Don't include captured frames generated locally.
frame_capture_*.png

# Don't include history file generated by migrations
app/src/persistence/schema.rs.orig

# Don't include personal Claude Code settings or local scratch
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/explorer-out/

# Owner-only agent notes (private remotes, internal paths). Never commit them.
CLAUDE.local.md
**/CLAUDE.local.md

# Local build/run logs.
# Ignore any *.log at the repo root rather than naming them one at a time - each new build script
# has so far added another (windows-release-build.log was the latest, at 5943 lines of noise in
# the diff). Nested paths are unaffected, so a genuine committed log elsewhere still shows up.
/*.log
cargo-tcb-build.txt
warp-oss.log
windows-bundle-build.log
bundle-windows*.log
bundle-windows*.start

# Tab drag development notes
pr_cleanup.md
desired_behavior.md

# Python bytecode caches.
__pycache__/

# Per-repo TwinCurrent files (release .env, thinking space). The name predates
# Mnemos IDE and stays: release scripts on both machines read it.
.twincurrent-build/

# dev/test artifacts (added during terminal-tabs work)
target-verify/
.build-logs/
*.bundle
*.stackdump
CONOUT$
CONIN$
run-build.cmd
launcher.ps1

# Secrets and owner-only files. These stay on the owners' machines and never reach
# the public tree (see script/oss/leak-check.sh).
.env*
*.pem
*.p12
*.key
.claude/skills/
.claude/scratch/
.mcp.json
CLAUDE.local.md
plans/
wireframes/
HANDOVER.md
