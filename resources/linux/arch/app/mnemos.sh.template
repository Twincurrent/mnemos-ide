#!/bin/bash

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-~/.config}

# Allow users to override command-line options
if [[ -f $XDG_CONFIG_HOME/mnemos-terminal@@CHANNEL_SUFFIX@@-flags.conf ]]; then
    MNEMOS_USER_FLAGS="$(grep -v '^#' $XDG_CONFIG_HOME/mnemos-terminal@@CHANNEL_SUFFIX@@-flags.conf)"
fi

# Launch
exec /opt/mnemos/mnemos-terminal@@CHANNEL_SUFFIX@@/@@BINARY_NAME@@ $MNEMOS_USER_FLAGS "$@"
